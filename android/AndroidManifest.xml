<?xml version="1.0" encoding="utf-8"?>
<!-- The Android app: Android's NativeActivity loads libcalculator.so (the Rust library, see
     src/lib.rs) and its android_main runs the app. There is no Java code. build-apk.ps1 adds
     the version from Cargo.toml (see README.md). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.gavrilov.calccraft">

    <application
        android:allowBackup="true"
        android:extractNativeLibs="false"
        android:hasCode="false"
        android:icon="@mipmap/ic_launcher"
        android:label="CalcCraft"
        android:theme="@style/CalcCraft">

        <!-- The app handles every configuration change itself: a restarted activity would
             start a second winit event loop, which winit doesn't allow. Phones stay upright,
             like Windows' calculator window, whose layouts need some 500 points of height
             (Android 16 ignores this on tablets). The keyboard pans the screen instead of
             shrinking it, for the same reason. -->
        <activity
            android:name="android.app.NativeActivity"
            android:configChanges="density|fontScale|keyboard|keyboardHidden|layoutDirection|locale|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustPan">
            <meta-data
                android:name="android.app.lib_name"
                android:value="calculator" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
